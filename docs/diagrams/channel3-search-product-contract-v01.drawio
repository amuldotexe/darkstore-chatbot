      <mxCell id="t" value="Channel3 UI — server-owned search and typed product contract" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1350" height="34" as="geometry"/></mxCell>
      <mxCell id="s" value="Observed flow: the consumer implements fetchSearch server-side, the hook owns query/filter/pagination state, and ProductGrid receives typed products with explicit interaction callbacks." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#5D6878;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="22" as="geometry"/></mxCell>
