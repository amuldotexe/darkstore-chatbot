      <mxCell id="n" value="Takeaway for us: this is the closest data/UI split to copy—keep provider credentials and product search behind our backend; hand the desktop a typed, client-safe product response." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFF9E7;strokeColor=#C79400;fontColor=#713F12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="355" width="1460" height="42" as="geometry"/></mxCell>
