<mxfile host="app.diagrams.net" modified="2026-08-30T00:00:00.000Z" agent="Codex" version="26.0.14" type="device">
  <diagram id="darkstore-propensity-cart-journey-v001" name="Darkstore propensity cart journey v001">
    <mxGraphModel dx="1600" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Dark-store fashion concierge — v001 source-of-truth PRD" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1A202C;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="50" y="28" width="1500" height="35" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Single detailed map. Read the central spine top-to-bottom for conversion; use the left and right columns only when the shopper changes discovery mode." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4A5568;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="1500" height="24" as="geometry"/></mxCell>
        <mxCell id="legend" value="Legend: Solid arrows = primary conversion path  |  Dashed arrows = optional branch  |  Purple = model choice only  |  Gold = product truth / validation  |  REQ-JOURNEY = v001 acceptance contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;fontSize=11;fontColor=#4A5568;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="1500" height="36" as="geometry"/></mxCell>

        <mxCell id="mainZone" value="MAIN CONVERSION SPINE — PRIMARY PATH" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="545" y="170" width="500" height="1110" as="geometry"/></mxCell>
        <mxCell id="keyInput" value="1. API key gate&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Shopper enters an OpenAI key before the concierge can start.&lt;br&gt;Key is held only for this local session.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-001.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="215" width="350" height="92" as="geometry"/></mxCell>
        <mxCell id="validateKey" value="Validate key&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Safe to proceed?&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="685" y="350" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="keyRejected" value="Explain validation issue;&lt;br&gt;allow retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1050" y="379" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="startConcierge" value="2. Concierge starts&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A warm prompt frames a quick, guided edit.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="495" width="350" height="82" as="geometry"/></mxCell>
        <mxCell id="topThree" value="3. First look: three highest-propensity products&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Three product cards show image, price, size, delivery and “why this”.&lt;br&gt;Fourth non-product action: “I want something else”.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-002.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="625" width="410" height="132" as="geometry"/></mxCell>
        <mxCell id="customChat" value="4. Selected product → customize in chat&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Product-anchored conversation helps with styling, fit and occasion.&lt;br&gt;Product-detail hyperlink is optional and secondary; it never breaks the chat path.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-003.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="820" width="410" height="145" as="geometry"/></mxCell>
        <mxCell id="addCart" value="5. Explicit add-to-cart action&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;The shopper commits from the chat after a focused recommendation.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-004.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="1020" width="350" height="88" as="geometry"/></mxCell>
        <mxCell id="mockCart" value="6. Local mock cart&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cart count updates; no checkout in v001.&lt;br&gt;Shopper can return to either discovery route without losing context.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="1160" width="350" height="92" as="geometry"/></mxCell>

        <mxCell id="differentZone" value="A. DIFFERENT REQUEST — THE FOURTH INITIAL CARD" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="70" y="585" width="370" height="710" as="geometry"/></mxCell>
        <mxCell id="otherBrief" value="I want something else&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;One free-text brief, for example: “linen shirt for Goa”.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-005.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="650" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="portfolioSearch" value="Search the local portfolio&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Use the brief to rank available fixture inventory.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="825" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="searchResults" value="Three search-result cards&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Choose one → enter the same customization-and-cart path at step 4.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1000" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="searchNextThree" value="Fourth card: Next three&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Advance to the next unseen search page.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-006.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1170" width="300" height="92" as="geometry"/></mxCell>

        <mxCell id="alternativesZone" value="B. THREE MORE LIKE THIS — AVAILABLE FROM CHAT OR CART" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="1160" y="765" width="370" height="530" as="geometry"/></mxCell>
        <mxCell id="threeAlternatives" value="See three alternatives&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Keep the shopper’s intent; exclude the selected SKU.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1195" y="840" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="alternativeResults" value="Three alternative cards&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Choose one → return to the same customization-and-cart path at step 4.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1195" y="1010" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="alternativeNextThree" value="Next three unseen alternatives&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Fourth card advances the alternative page.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1195" y="1180" width="300" height="82" as="geometry"/></mxCell>

        <mxCell id="contractZone" value="GROUNDING CONTRACT AND PRD ACCEPTANCE" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="70" y="1360" width="1460" height="355" as="geometry"/></mxCell>
        <mxCell id="fixture" value="Catalog fixture&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Artificial inventory owns SKU, price, images, stock, sizes and delivery.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="125" y="1445" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="modelChoice" value="GPT-4o decision layer&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ranks allowed IDs and writes conversational rationale only.&lt;br&gt;It never invents product facts.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="1445" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="guard" value="Tauri validation and rehydration&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Validate returned IDs against the fixture; rehydrate all rendered facts from the fixture; reject invalid output safely.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#B7791F&quot;&gt;REQ-JOURNEY-007.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="875" y="1430" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="typedUi" value="Typed UI state&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Only validated catalog facts reach cards and cart.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="1445" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="prdNote" value="PRD definition of done: key gate blocks start; first look always shows exactly 3 products + 1 non-product action; selected items customize in chat; cart is local-only; both discovery branches page in threes; only validated fixture data is rendered." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontColor=#2D3748;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="125" y="1635" width="1365" height="42" as="geometry"/></mxCell>

        <mxCell id="e1" value="Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#805AD5;fontSize=10;fontColor=#553C9A;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="keyInput" target="validateKey"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#38A169;fontSize=10;fontColor=#276749;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="validateKey" target="startConcierge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#C53030;fontSize=10;fontColor=#9B2C2C;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="validateKey" target="keyRejected"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Surface first look" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3182CE;fontSize=10;fontColor=#2B6CB0;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="startConcierge" target="topThree"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Choose a product" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#805AD5;fontSize=10;fontColor=#553C9A;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="topThree" target="customChat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Ready to buy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#38A169;fontSize=10;fontColor=#276749;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="customChat" target="addCart"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Add" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#38A169;fontSize=10;fontColor=#276749;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="addCart" target="mockCart"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Fourth action card" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#805AD5;fontSize=10;fontColor=#553C9A;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="topThree" target="otherBrief"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Submit brief" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3182CE;fontSize=10;fontColor=#2B6CB0;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="otherBrief" target="portfolioSearch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Rank available items" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3182CE;fontSize=10;fontColor=#2B6CB0;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="portfolioSearch" target="searchResults"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="Next page" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#805AD5;fontSize=10;fontColor=#553C9A;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="searchResults" target="searchNextThree"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="See alternatives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#805AD5;fontSize=10;fontColor=#553C9A;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="customChat" target="threeAlternatives"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="Rank alternates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3182CE;fontSize=10;fontColor=#2B6CB0;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="threeAlternatives" target="alternativeResults"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="Next page" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#805AD5;fontSize=10;fontColor=#553C9A;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="alternativeResults" target="alternativeNextThree"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B7791F;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="fixture" target="modelChoice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#805AD5;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="modelChoice" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#38A169;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="guard" target="typedUi"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
