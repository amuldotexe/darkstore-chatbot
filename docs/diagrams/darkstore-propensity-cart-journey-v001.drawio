<mxfile host="app.diagrams.net" modified="2026-08-30T00:00:00.000Z" agent="Codex" version="26.0.14" type="device">
  <diagram id="darkstore-propensity-cart-journey-v001" name="Darkstore propensity cart journey v001">
    <mxGraphModel dx="1600" dy="2420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Darkstore Concierge — v001 source-of-truth PRD" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1A202C;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="50" y="28" width="1500" height="35" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Single detailed map. v001 carries eight embedded dresses: three, three, then the final two, followed by a clear No more inventory state." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4A5568;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="1500" height="24" as="geometry"/></mxCell>
        <mxCell id="legend" value="Legend: Solid arrows = primary conversion path  |  Dashed arrows = recovery, reselection or data dependency  |  Purple = GPT category decision only  |  Gold = embedded product truth / validation  |  REQ-TAURI = v001 acceptance contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;fontSize=11;fontColor=#4A5568;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="1500" height="36" as="geometry"/></mxCell>

        <mxCell id="mainZone" value="MAIN CONVERSION SPINE — PRIMARY PATH" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="545" y="170" width="500" height="1765" as="geometry"/></mxCell>
        <mxCell id="keyInput" value="1. API key gate&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Shopper enters an OpenAI key before the concierge can start.&lt;br&gt;Key is held only for this local session; a failed check returns focus here.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-001.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="215" width="350" height="92" as="geometry"/></mxCell>
        <mxCell id="validateKey" value="Validate key&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Safe to proceed?&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="685" y="350" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="startConcierge" value="2. Concierge starts&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A warm prompt frames a quick, guided fashion edit.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="495" width="350" height="82" as="geometry"/></mxCell>
        <mxCell id="topThree" value="3. First look: three highest-propensity dresses&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Within matched `dresses`, exactly three distinct, available cards show price, size, delivery and “why this”.&lt;br&gt;Fourth non-product action: “I want something else”.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-002.0 / 008.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="625" width="410" height="132" as="geometry"/></mxCell>
        <mxCell id="customChat" value="4. Selected product → customize in chat&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Input: selected product ID + source + retained brief. Help with styling, fit and occasion.&lt;br&gt;The optional product-detail hyperlink never breaks this chat state.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-003.0 / 009.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="860" width="410" height="145" as="geometry"/></mxCell>
        <mxCell id="variantChoice" value="5. Confirm purchasable variant&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Chat captures the required size / colour / variant before purchase intent can continue.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#B7791F&quot;&gt;REQ-JOURNEY-010.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="1060" width="350" height="88" as="geometry"/></mxCell>
        <mxCell id="inventoryRecheck" value="6. Recheck price and fixture availability&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Read the embedded fixture again immediately before add-to-cart.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#B7791F&quot;&gt;REQ-TAURI-007.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="1205" width="350" height="80" as="geometry"/></mxCell>
        <mxCell id="stockDecision" value="Still purchasable?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="685" y="1330" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="addCart" value="7. Explicit add-to-cart action&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;The shopper commits from the chat after a focused recommendation and stock check.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-004.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="1475" width="350" height="88" as="geometry"/></mxCell>
        <mxCell id="mockCart" value="8. Local mock cart&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cart count updates; no checkout in v001. The chosen variant, shopping brief and cart remain in session.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="1615" width="350" height="92" as="geometry"/></mxCell>
        <mxCell id="postCartRoutes" value="After add: continue without losing context&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Actions reopen Step 3 first look, route A new brief, or route B alternatives. Cart state persists.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-JOURNEY-011.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#718096;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="1765" width="410" height="105" as="geometry"/></mxCell>

        <mxCell id="contextZone" value="SEEDED FIRST-LOOK CONTEXT — V001 DEMO DATA" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="1100" y="570" width="380" height="220" as="geometry"/></mxCell>
        <mxCell id="decisionContext" value="One-category runtime taxonomy&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Embedded catalogue exposes `[dresses]` only, plus seeded shopper persona + trend snapshot.&lt;br&gt;GPT returns `matched:dresses` or `not_in_inventory`; local scores make pages reproducible.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-TAURI-003.0 / 013.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1135" y="610" width="310" height="140" as="geometry"/></mxCell>

        <mxCell id="differentZone" value="A. DIFFERENT REQUEST — THE FOURTH INITIAL CARD" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="70" y="585" width="370" height="1010" as="geometry"/></mxCell>
        <mxCell id="otherBrief" value="I want something else → brief entry&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Clear the stale first-look tray. The shopper enters one brief, then selects “Show matching dresses”.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-TAURI-023.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="650" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="categoryDecision" value="Matched `dresses`?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Validate GPT category against embedded taxonomy.&lt;/font&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="145" y="790" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="portfolioSearch" value="Brief pending: “Finding matching dresses…”&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Disable submit, then query the embedded catalogue and rank available `dresses` by local propensity. No other category is substituted.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="920" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="searchResults" value="Brief results: 3, 3, then final 1–2 cards&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Label the submitted brief and category-then-propensity rule. Tap a card to re-anchor Step 4 chat.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#3182CE&quot;&gt;REQ-TAURI-023.0 / 016.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1060" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="searchNextThree" value="Fourth action: Show 3 more&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Show while any unseen dress remains; exclude shown SKUs and refresh the tray.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#805AD5&quot;&gt;REQ-TAURI-004.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1215" width="300" height="86" as="geometry"/></mxCell>
        <mxCell id="searchTerminal" value="Terminal card: No more inventory.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;After the final 1–2-card page—or a guarded repeated request—hide Show 3 more and retain the brief and valid tray.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#C53030&quot;&gt;REQ-TAURI-024.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1340" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="missingCategory" value="Not in inventory → no cards&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;“I can currently help with dresses.” Retain and refocus the brief; do not make a substitute query.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#C53030&quot;&gt;REQ-TAURI-014.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1455" width="300" height="82" as="geometry"/></mxCell>

        <mxCell id="alternativesZone" value="B. THREE MORE LIKE THIS — CHAT, CART OR STOCK RECOVERY" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="1160" y="800" width="370" height="480" as="geometry"/></mxCell>
        <mxCell id="threeAlternatives" value="Open the alternative tray&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Keep shopper intent + category; show up to three unseen eligible alternatives.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1195" y="888" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="alternativeResults" value="Alternative cards: 3, then final 1–2&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tap a card: selected product ID re-anchors the same Step 4 chat.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1195" y="1025" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="alternativeNextThree" value="Fourth card: Show 3 more&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Show while unseen alternatives remain; final partial page ends with No more inventory.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1195" y="1165" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="stockRecovery" value="Fixture unavailable&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Preserve the brief; explain the demo option is unavailable; show alternatives only as a complete three-card set.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#B7791F&quot;&gt;REQ-JOURNEY-010.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="1340" width="370" height="84" as="geometry"/></mxCell>

        <mxCell id="contractZone" value="GROUNDING CONTRACT AND PRD ACCEPTANCE" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="70" y="2000" width="1460" height="355" as="geometry"/></mxCell>
        <mxCell id="fixture" value="Embedded eight-dress catalogue&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Compiled from the source-compatible seed. Availability, 2–3 sizes, delivery and scores are declared fixture values.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="2050" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="modelChoice" value="GPT-4o category decision layer&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Returns `matched:dresses` or `not_in_inventory`, with rationale only.&lt;br&gt;It never ranks products, invents facts, or substitutes a category.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="465" y="2050" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="guard" value="Tauri embedded validation, ranking and rehydration&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Validate result; read fixture-available `dresses`; sort propensity DESC / SKU ASC; rehydrate facts; recheck variant fixture availability before cart. The packaged app has no runtime catalogue network dependency.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#B7791F&quot;&gt;REQ-TAURI-013.0 / 016.0 / 017.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="865" y="2040" width="410" height="180" as="geometry"/></mxCell>
        <mxCell id="typedUi" value="Typed UI state&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Validated category and embedded DTO facts reach cards, chat and cart.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1325" y="2050" width="170" height="160" as="geometry"/></mxCell>
        <mxCell id="prdNote" value="PRD definition of done: Darkstore Concierge key gate blocks start; GPT returns matched:dresses or not_in_inventory; the embedded eight-row catalogue supplies pages of 3, 3, then final 2 cards plus No more inventory.; an absent category shows no cards and keeps the brief editable; selected cards re-anchor chat; size and fixture availability are confirmed before local cart; only rehydrated DTO data is rendered." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontColor=#2D3748;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="2260" width="1405" height="58" as="geometry"/></mxCell>

        <mxCell id="e1" value="Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#805AD5;fontSize=10;fontColor=#553C9A;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="keyInput" target="validateKey"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#38A169;fontSize=10;fontColor=#276749;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="validateKey" target="startConcierge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Failed: refocus field" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#C53030;fontSize=10;fontColor=#9B2C2C;exitX=0;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="validateKey" target="keyInput"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="400"/><mxPoint x="520" y="261"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="Surface first look" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3182CE;fontSize=10;fontColor=#2B6CB0;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="startConcierge" target="topThree"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Matched category + score inputs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#805AD5;fontSize=10;fontColor=#553C9A;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="decisionContext" target="topThree"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Choose a product" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#805AD5;fontSize=10;fontColor=#553C9A;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="topThree" target="customChat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Confirm variant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B7791F;fontSize=10;fontColor=#744210;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="customChat" target="variantChoice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Recheck" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B7791F;fontSize=10;fontColor=#744210;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="variantChoice" target="inventoryRecheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Latest state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B7791F;fontSize=10;fontColor=#744210;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="inventoryRecheck" target="stockDecision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#38A169;fontSize=10;fontColor=#276749;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="stockDecision" target="addCart"><mxGeometry relative="1" as="geometry"/></mxCell>
