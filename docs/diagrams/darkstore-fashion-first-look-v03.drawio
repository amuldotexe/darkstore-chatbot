        <mxCell id="e5" value="3 SKU IDs + reasons" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9A66B3;strokeWidth=2;fontSize=11;fontColor=#581C87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="curateLooks" target="validateResponse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="grounded payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#147A58;strokeWidth=2;fontSize=11;fontColor=#14532D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="validateResponse" target="homeLookResponse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="show cards + evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#147A58;strokeWidth=2;fontSize=11;fontColor=#14532D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="homeLookResponse" target="firstLook"><mxGeometry relative="1" as="geometry"/></mxCell>
