  <diagram id="darkstore-v003-first-look" name="V003 First-Look Journey">
    <mxGraphModel dx="2200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Dark-store fashion concierge — v003 first-look journey" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1320" height="32" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="The shopper sees three explainable, locally deliverable looks. GPT-4o chooses only from the fixture; Tauri validates every visible fact before cards appear." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5D6878;" vertex="1" parent="1"><mxGeometry x="40" y="57" width="1600" height="22" as="geometry"/></mxCell>
        <mxCell id="legend" value="Solid = v001 happy path  ·  Green = grounded payload  ·  Grey callout = v002 extension" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#5D6878;" vertex="1" parent="1"><mxGeometry x="1590" y="29" width="570" height="22" as="geometry"/></mxCell>
        <mxCell id="shopperHeader" value="SHOPPER JOURNEY" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#DDEAFE;swimlaneFillColor=#F5F9FF;strokeColor=#AABDD8;fontStyle=1;fontSize=13;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="2120" height="270" as="geometry"/></mxCell>
        <mxCell id="systemHeader" value="SUPPORTING APP CONTRACTS — invisible to the shopper, essential to product truth" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#E9F6ED;swimlaneFillColor=#FAFFFB;strokeColor=#A8C8AF;fontStyle=1;fontSize=13;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="2120" height="385" as="geometry"/></mxCell>
        <mxCell id="openDemo" value="1. Open the local demo" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F5F9FF;strokeColor=#5B8DEF;fontColor=#172033;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="205" width="205" height="64" as="geometry"/></mxCell>
        <mxCell id="sessionKey" value="2. First launch: add GPT-4o key&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Confido-style session setup · no fashion cards yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F5F9FF;strokeColor=#5B8DEF;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="190" width="270" height="92" as="geometry"/></mxCell>
        <mxCell id="startConcierge" value="3. Start concierge&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the first shopper-facing action&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F5F9FF;strokeColor=#5B8DEF;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="197" width="230" height="78" as="geometry"/></mxCell>
        <mxCell id="firstLook" value="4. Your first three looks&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;three tappable product cards · price · size · local delivery · why shown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2FAF5;strokeColor=#3D9470;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="180" width="440" height="112" as="geometry"/></mxCell>
        <mxCell id="exploreLook" value="5. Explore a look&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;open the product · ask a question · see factual availability&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F5F9FF;strokeColor=#5B8DEF;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1900" y="197" width="210" height="78" as="geometry"/></mxCell>
        <mxCell id="fixture" value="Sample catalog fixture&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SKU · image · price · size · stock&lt;br&gt;50-minute promise · colour&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4E8;strokeColor=#D98A38;fontColor=#7C2D12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="545" width="255" height="92" as="geometry"/></mxCell>
        <mxCell id="curateLooks" value="GPT-4o curates&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;receives fixture facts only&lt;br&gt;returns 3 SKU IDs + reasons&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F4EDF8;strokeColor=#9A66B3;fontColor=#581C87;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="545" width="255" height="92" as="geometry"/></mxCell>
        <mxCell id="validateResponse" value="Tauri validates response&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;exactly 3 distinct known SKUs&lt;br&gt;rehydrates every visible fact from fixture&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9E7;strokeColor=#C79400;fontColor=#713F12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1185" y="538" width="285" height="106" as="geometry"/></mxCell>
        <mxCell id="homeLookResponse" value="Typed HomeLookResponse&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;validated cards + evidence only&lt;br&gt;never raw model JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2FAF5;strokeColor=#3D9470;fontColor=#14532D;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1610" y="545" width="260" height="92" as="geometry"/></mxCell>
        <mxCell id="retryCuration" value="Guardrail: if the response is invalid, rerun curation. No partial or invented cards." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FDECEC;strokeColor=#CC5A54;fontColor=#7F1D1D;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1145" y="680" width="365" height="40" as="geometry"/></mxCell>
        <mxCell id="refineBrief" value="V002 extension: “I’m looking for something else”&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;collect a new brief, then re-enter GPT curation under the same fixture contract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;dashed=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1745" y="680" width="355" height="55" as="geometry"/></mxCell>
        <mxCell id="trustBoundary" value="Trust boundary: GPT-4o may choose and explain. Only the fixture supplies product facts; only Tauri can turn a selection into visible cards." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FFF9E7;strokeColor=#C79400;fontColor=#713F12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="115" y="745" width="930" height="34" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" parent="1" source="openDemo" target="sessionKey"><mxGeometry relative="1" as="geometry"/></mxCell>
