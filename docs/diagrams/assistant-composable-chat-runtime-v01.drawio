  <diagram id="assistant-composable-chat-runtime" name="Assistant Composable Chat Runtime">
    <mxGraphModel dx="1700" dy="650" grid="1" gridSize="10" page="0" pageScale="1" pageWidth="1700" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="assistant-ui — composable chat runtime" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1000" height="34" as="geometry"/></mxCell>
      <mxCell id="s" value="Observed flow: an app selects a runtime hook and adapter, exposes that runtime through a provider, then composes independent thread and generative UI primitives." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#5D6878;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1450" height="22" as="geometry"/></mxCell>
      <mxCell id="app" value="APPLICATION INTEGRATION" style="swimlane;html=1;startSize=28;fillColor=#F4EDF8;swimlaneFillColor=#FCFAFF;strokeColor=#B99ACB;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="725" height="180" as="geometry"/></mxCell>
      <mxCell id="ui" value="assistant-ui PRIMITIVES" style="swimlane;html=1;startSize=28;fillColor=#DDEAFE;swimlaneFillColor=#F7FAFF;strokeColor=#AABDD8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="105" width="845" height="180" as="geometry"/></mxCell>
      <mxCell id="a" value="App adapter&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;model / transport integration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFAFF;strokeColor=#9A66B3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="160" width="190" height="76" as="geometry"/></mxCell>
      <mxCell id="b" value="useLocalRuntime / transport runtime&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;runtime chosen by app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFAFF;strokeColor=#9A66B3;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="158" width="245" height="80" as="geometry"/></mxCell>
      <mxCell id="c" value="AssistantRuntimeProvider&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;exposes runtime to descendants&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#5B8DEF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="875" y="158" width="235" height="80" as="geometry"/></mxCell>
      <mxCell id="d" value="Thread primitives&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;messages · composer · scroll&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#5B8DEF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="158" width="200" height="80" as="geometry"/></mxCell>
      <mxCell id="e" value="Generative UI / tool renderers&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;specialised presentational pieces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF5;strokeColor=#3D9470;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="158" width="170" height="80" as="geometry"/></mxCell>
      <mxCell id="n" value="Takeaway for us: the attractive part is composability—own the product data/runtime boundary, then use a UI library only for presentation and interaction primitives." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFF9E7;strokeColor=#C79400;fontColor=#713F12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="355" width="1510" height="42" as="geometry"/></mxCell>
