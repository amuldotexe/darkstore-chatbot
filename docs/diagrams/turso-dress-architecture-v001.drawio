  <diagram id="turso-dress-architecture-v001" name="Page-1">
    <mxGraphModel dx="1600" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Turso Dress Concierge — v001 Runtime Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1A202C;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="1510" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="A narrow desktop boundary: GPT-4o interprets a category; Rust validates it; Turso supplies every product fact and deterministic three-card set." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4A5568;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="58" width="1510" height="24" as="geometry"/></mxCell>
        <mxCell id="legend" value="Solid = runtime request or response  |  Dashed = provisioning / derived source data  |  Purple = model interpretation only  |  Gold = Turso truth  |  Red = intentionally distinct recovery state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;fontSize=11;fontColor=#4A5568;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="93" width="1510" height="34" as="geometry"/></mxCell>
        <mxCell id="uiZone" value="TAURI WEBVIEW — TYPESCRIPT / REACT" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=#F7FAFC;strokeColor=#A0AEC0;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="45" y="150" width="485" height="500" as="geometry"/></mxCell>
        <mxCell id="backendZone" value="TAURI RUST BACKEND — COMMANDS, CORE, ADAPTERS" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=#FFFAF0;strokeColor=#B7791F;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#744210;" vertex="1" parent="1"><mxGeometry x="555" y="150" width="535" height="500" as="geometry"/></mxCell>
        <mxCell id="remoteZone" value="REMOTE PROVIDERS — RUST ONLY" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=#FAF5FF;strokeColor=#805AD5;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#44337A;" vertex="1" parent="1"><mxGeometry x="1115" y="150" width="440" height="500" as="geometry"/></mxCell>
        <mxCell id="shopper" value="Shopper&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;API key, brief, card and variant choice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#2D3748;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="75" y="210" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="ui" value="Desktop concierge UI&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Key gate · 3 cards + fourth action&lt;br&gt;Chat customization · local cart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#1A365D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="195" height="140" as="geometry"/></mxCell>
        <mxCell id="uiState" value="Ephemeral reducer state&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Latest request ID · shown SKU stream&lt;br&gt;Brief, chat anchor and local cart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="405" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="commands" value="Narrow Tauri commands&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Owned request DTOs and tagged responses&lt;br&gt;No database or OpenAI credential crosses IPC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;fontColor=#744210;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="190" width="205" height="140" as="geometry"/></mxCell>
        <mxCell id="session" value="In-memory session state&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;User key, brief, chat anchor, cart&lt;br&gt;Cleared at replacement and close&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="835" y="205" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="core" value="Catalog core&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Read taxonomy · validate category&lt;br&gt;Filter fixture_available = 1&lt;br&gt;Sort score DESC, SKU ASC · page in threes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="410" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="model" value="GPT-4o gateway&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Receives brief + actual taxonomy&lt;br&gt;Returns matched:dresses or not_in_inventory&lt;br&gt;Never sees product ranking authority&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="865" y="410" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="openai" value="OpenAI GPT-4o&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Category interpretation only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;fontColor=#44337A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="205" width="325" height="110" as="geometry"/></mxCell>
        <mxCell id="turso" value="Turso / libSQL&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;inventory_products&lt;br&gt;One table · eight dresses · source facts + fixture fields&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="410" width="325" height="140" as="geometry"/></mxCell>
        <mxCell id="notInventory" value="not_in_inventory&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;No cards · Dresses-only copy&lt;br&gt;Retain and refocus the brief&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="580" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="inventoryUnavailable" value="inventory_unavailable&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Retry copy · no cards · preserve context&lt;br&gt;Never mislabel as absent category&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="570" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="sourceZone" value="CHECKED-IN INPUTS AND BACKEND CONFIGURATION" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=10;fillColor=none;strokeColor=#718096;dashed=1;dashPattern=4 4;fontStyle=1;fontSize=12;fontColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="45" y="685" width="1510" height="330" as="geometry"/></mxCell>
        <mxCell id="sourceRows" value="Captured Slikk source rows&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SKU, title, price, URL, capture facts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#718096;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="95" y="770" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="seed" value="darkstore-dresses-v001.sql&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Strict one-table seed&lt;br&gt;8 rows; 2–3 sizes; fixture_* assumptions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#B7791F;fontColor=#744210;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="755" width="285" height="130" as="geometry"/></mxCell>
        <mxCell id="env" value=".env.local (ignored)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TURSO_DATABASE_URL · TURSO_AUTH_TOKEN&lt;br&gt;Read by Rust only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="895" width="290" height="75" as="geometry"/></mxCell>
        <mxCell id="deploy" value="User-authenticated Turso deployment&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Create database from the checked-in seed&lt;br&gt;No remote database is assumed in this repository&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#718096;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1110" y="755" width="355" height="130" as="geometry"/></mxCell>
        <mxCell id="boundary" value="Security boundary: the WebView connects only to self. Rust alone sends HTTPS to OpenAI and Turso; DTOs expose only rehydrated product facts, never the user API key, Turso token, or provider response body.  |  REQ-TAURI-003.0, -013.0, -014.0, -015.0, -016.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontColor=#2D3748;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1040" width="1460" height="55" as="geometry"/></mxCell>
